# Copy this file to .env and fill in your values. Never share or commit .env.

# ---------- PostgreSQL (one database; schemas bronze, silver, gold, audit are created by --setup)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=datatrust_poc
PG_USER=postgres
PG_PASSWORD=change-me
# Prefer TLS when supported; set to require for Azure PostgreSQL.
PGSSLMODE=prefer

# ---------- DataTrust's OWN database: logins, connections, connector telemetry, approvals, alerts.
# Separate from the data it monitors (the PG_* database above is just one connected source).
# Created on first start if the user may create databases; existing portal/telemetry rows move over once.
# Leave unset to use the PG_* server with database datatrust_app.
APP_PG_HOST=
APP_PG_PORT=
APP_PG_DATABASE=datatrust_app
APP_PG_USER=
APP_PG_PASSWORD=
APP_PGSSLMODE=

# ---------- Where the CSV files come from: local (data/source_csv) or adls
SOURCE_MODE=local

# ---------- ADLS Gen2 (for pipeline worker; local uploads use upload_to_adls.py)
# Option 1: account name + key (Azure portal -> Storage account -> Access keys)
ADLS_ACCOUNT_NAME=yourstorageaccount
ADLS_ACCOUNT_KEY=
# Option 2: connection string instead (also from Access keys).
#   For the free local emulator Azurite use:  ADLS_CONNECTION_STRING=UseDevelopmentStorage=true
ADLS_CONNECTION_STRING=
# Option 3: leave key and connection string empty -> uses your Azure login (az login)
ADLS_CONTAINER=landing
# Worker scans batches/<batch-name>/ for CSV files and _READY. Batch name: full or YYYY-MM-DD.
ADLS_FOLDER=batches
ADLS_WORKER_POLL_SECONDS=30

# ---------- How Spark writes to PostgreSQL: python (default, no downloads) or jdbc
WRITE_MODE=python

# ---------- DataTrust AI web app (python web/server.py -> http://localhost:8000)
WEB_PORT=8000
# 'last month', 'last 7 days' ... count back from: data = latest business date in gold (default), today = calendar date
DATATRUST_AS_OF=data
# AI model for free-form questions: none (built-in, free, offline) | ollama (free, local) | anthropic or gemini (paid APIs)
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Kafka streaming add-on (streaming/)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=datatrust-bronze-loader
KAFKA_TOPIC_PREFIX=datatrust
KAFKA_MICRO_BATCH_SECONDS=30
KAFKA_MICRO_BATCH_MAX_EVENTS=5000
KAFKA_RUN_SILVER_GOLD=true
# managed Kafka (Confluent Cloud / Azure Event Hubs): SASL_SSL + user/password
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ---------- Site-wide web login (email/password, email verification, password reset, Google SSO)
# First admin bootstrap. Set a real email and strong password; no admin/admin default is provided.
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=
# Set false only for a trusted local instance; all APIs/admin actions are then unauthenticated.
PORTAL_AUTH_ENABLED=true
# Optional comma-separated emails that should receive admin role after verified signup/Google SSO.
PORTAL_ADMIN_EMAILS=
# Signs site and OAuth session cookies. Generate a long random value and keep it stable.
PORTAL_SECRET=
# Set true when served over HTTPS (including Azure App Service).
PORTAL_COOKIE_SECURE=false
# Public HTTPS origin used in email links, e.g. https://datatrust.example.com
DATATRUST_PUBLIC_URL=
# Google Cloud OAuth web client; register DATATRUST_PUBLIC_URL/api/auth/google/callback as redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail SMTP: use a Google App Password (requires 2-Step Verification), not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# ---------- Azure Data Factory connector (web/adf). Factories are normally added on the "Connect ADF" page;
# these optional variables add one automatically on first start. Only the secret's VALUE lives here, never in the database.
ADF_SUBSCRIPTION_ID=
ADF_RESOURCE_GROUP=
ADF_FACTORY_NAME=
# service principal (leave ADF_CLIENT_ID empty to use managed identity / az login instead)
ADF_TENANT_ID=
ADF_CLIENT_ID=
ADF_CLIENT_SECRET=
# how often each factory is read (seconds); false = run the collector separately (python web/adf/collector.py)
ADF_POLL_SECONDS=300
ADF_COLLECTOR_IN_WEB=true
# source files larger than this are not row-counted
ADF_PROBE_MAX_MB=100

# passwords of other connected sources, referenced by name on the Connections page, e.g.
# CONN_FINANCE_PASSWORD=...
