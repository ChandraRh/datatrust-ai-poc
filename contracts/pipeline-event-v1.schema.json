{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataTrust Pipeline Telemetry Event",
  "description": "Version 1 event envelope for external pipeline and data-asset telemetry. This is a contract, not an active ingestion API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "tenant_id",
    "source",
    "pipeline",
    "run"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable unique DataTrust event identifier; use the producer event ID when available."
    },
    "event_type": {
      "enum": [
        "run.queued",
        "run.started",
        "run.completed",
        "run.failed",
        "run.cancelled",
        "task.started",
        "task.completed",
        "task.failed",
        "asset.read",
        "asset.written",
        "quality.check.completed"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the source says this event occurred."
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "description": "Tenant boundary assigned by the authenticated integration; never trust an unverified caller value."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "platform"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "description": "Source system, for example azure_data_factory or databricks."
        },
        "external_event_id": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "region": {
          "type": "string"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_id",
        "name"
      ],
      "properties": {
        "pipeline_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "status"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_run_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "name"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "name",
        "operation"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable, source-qualified asset identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "operation": {
          "enum": [
            "read",
            "write"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "description": "Sanitized summary. Do not send secrets, credentials, or unrestricted raw logs."
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "quality_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "status"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning",
            "unknown"
          ]
        },
        "evaluated_rows": {
          "type": "integer",
          "minimum": 0
        },
        "failed_rows": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Optional, non-sensitive producer context. Do not use for credentials or personal data.",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "task.started",
              "task.completed",
              "task.failed"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "task"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "asset.read",
              "asset.written"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "asset"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "run.failed",
              "task.failed"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "quality.check.completed"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "required": [
          "quality_check"
        ]
      }
    }
  ]
}
