# DataTrust ADLS-to-PostgreSQL pipeline worker (separate from the web image).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    SOURCE_MODE=adls \
    ADLS_ACCOUNT_KEY=

RUN apt-get update && apt-get install -y --no-install-recommends \
      openjdk-17-jre-headless procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-pipeline.txt .
RUN pip install --no-cache-dir -r requirements-pipeline.txt

COPY config.py adls_utils.py db_utils.py spark_utils.py run_pipeline.py ./
COPY batch_status.py ./
COPY bronze_layer.py silver_layer.py gold_layer.py dq_rules.py ./
COPY sql/ sql/
COPY adls_pipeline_worker.py ./

RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/data/adls_download \
    && chown -R appuser:appuser /app
USER appuser

CMD ["python", "adls_pipeline_worker.py"]
